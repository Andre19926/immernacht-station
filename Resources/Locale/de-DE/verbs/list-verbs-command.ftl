### Localization used for the list verbs command.
# Mostly help + error messages.

list-verbs-command-description = Listet alle Verben auf, die ein Spieler auf einer bestimmten Entity verwenden kann.
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>

list-verbs-command-invalid-args = listverbs erwartet 2 Argumente.

list-verbs-command-invalid-player-uid = Die Spieler-UID konnte nicht gelesen werden, oder „self“ wurde nicht angegeben.
list-verbs-command-invalid-target-uid = Die Ziel-UID konnte nicht gelesen werden.

list-verbs-command-invalid-player-entity = Die angegebene Spieler-UID gehört zu keiner gültigen Entity.
list-verbs-command-invalid-target-entity = Die angegebene Ziel-UID gehört zu keiner gültigen Entity.

list-verbs-verb-listing = { $type }: { $verb }
