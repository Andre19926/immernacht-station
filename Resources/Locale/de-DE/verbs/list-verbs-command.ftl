### Localization used for the list verbs command.
# Mostly help + error messages.

list-verbs-command-description = Listet alle Verben auf, die ein Spieler auf einer bestimmten Entität verwenden kann.
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>

list-verbs-command-invalid-args = listverbs nimmt 2 Argumente.

list-verbs-command-invalid-player-uid = Spieler uid konnte nicht analysiert werden, oder "selbst" wurde nicht übergeben.
list-verbs-command-invalid-target-uid = Ziel-UID konnte nicht analysiert werden.

list-verbs-command-invalid-player-entity = Die gegebene Spieler-Uid entspricht nicht einer gültigen Entität.
list-verbs-command-invalid-target-entity = Target uid given entspricht nicht einer gültigen Entität.

list-verbs-verb-listing = { $type }: { $verb }
