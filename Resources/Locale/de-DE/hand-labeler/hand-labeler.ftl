# Verb text
hand-labeler-remove-label-text = Entfernen des Etiketts
hand-labeler-add-label-text = Anbringungsetikett

# Shown when the labeler is examined
hand-labeler-examine-blank = Der Etikettentext ist leer.
hand-labeler-examine-label-text = Der Etikettentext ist '{$label-text}'.
