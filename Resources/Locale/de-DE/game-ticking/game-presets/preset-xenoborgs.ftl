xenoborgs-title = Xenoborgs
xenoborgs-description = Ein Xenoborg-Mutterschiff wurde in der Nähe der Station entdeckt. Verhindere, dass es jedes empfindungsfähige Wesen in einen Xenoborg verwandelt.

xenoborgs-welcome = Du bist ein Xenoborg. Beschütze den Mutterschiffkern und hilf ihm, mehr Xenoborgs zu bauen, bis alles kohlenstoffbasierte Leben zu Silizium geworden ist.

mothership-welcome = Du bist der Kern des Mutterschiffs. Führe die Xenoborgs, damit sie dir Materialien und empfindungsfähige Gehirne bringen, sodass du die Xenoborg-Armee vergrößern und alles kohlenstoffbasierte Leben in Silizium verwandeln kannst.

xenoborg-shuttle-call = Wir haben festgestellt, dass Xenoborgs die Station überholt haben. Versand eines Notfall-Shuttles, um das verbleibende Personal zu sammeln.

xenoborgs-borgsmajor = [color=deepskyblue]Großer Sieg für die Xenoborgs![/color]
xenoborgs-borgsminor = [color=deepskyblue]Kleiner Sieg für die Xenoborgs![/color]
xenoborgs-neutral = [color=white]Neutrales Ergebnis![/color]
xenoborgs-crewminor = [color=yellow]Kleiner Sieg für die Crew![/color]
xenoborgs-crewmajor = [color=yellow]Großer Sieg für die Crew![/color]

xenoborgs-cond-all-xenoborgs-dead-core-alive = Alle Xenoborgs wurden zerstört. Der Mutterschiffkern bleibt im Raum treibend.
xenoborgs-cond-all-xenoborgs-dead-core-dead = Der Mutterschiffkern wurde zerstört und es gibt keine Xenoborgs mehr.

xenoborg-number-xenoborg-alive-end = Anzahl der lebenden Xenoborgs: {$count}
xenoborg-number-crew-alive-end = Anzahl lebender Crewmitglieder: {$count}

xenoborg-max-number = Die höchste Anzahl von Xenoborgs war: {$count}

xenoborgs-list-start = Das Startteam von xenoborg war:
