xenoborgs-title = Xenoborgs
xenoborgs-description = Ein Xenoborg Mutterschiff wurde in der Nähe der Station entdeckt. Halten Sie sie davon ab, jedes fühlende Wesen in einen Xenoborg zu verwandeln.

xenoborgs-welcome = Du bist ein Xenoborg. Schützen und helfen Sie dem Mutterschiffkern, mehr Xenoborgs herzustellen. und schließlich verwandeln alle Kohlenstoff-basierte Lebensform in Silizium.

mothership-welcome = Du bist der Mutterschiffkern. Führen Sie die Xenoborgs, damit sie Ihre Materialien und fühlenden Gehirne bringen können, damit Sie die Xenoborg-Armee wachsen lassen und alle kohlenstoffbasierten Lebensformen in Silizium verwandeln können.

xenoborg-shuttle-call = Wir haben festgestellt, dass Xenoborgs die Station überholt haben. Versand eines Notfall-Shuttles, um das verbleibende Personal zu sammeln.

xenoborgs-borgsmajor = [color=deepskyblue]Xenoborg großer Sieg![/color]
xenoborgs-borgsminor = [color=deepskyblue]Xenoborg kleiner Sieg![/color]
xenoborgs-neutral = [color=white]Neutrales Ergebnis![/color]
xenoborgs-crewminor = [color=yellow]Mannschaft kleiner Sieg![/color]
xenoborgs-crewmajor = [color=yellow]Crew großer Sieg![/color]

xenoborgs-cond-all-xenoborgs-dead-core-alive = Alle Xenoborgs wurden zerstört. Der Mutterschiffkern bleibt im Raum treibend.
xenoborgs-cond-all-xenoborgs-dead-core-dead = Der Mutterschiffkern wurde zerstört und es gibt keine Xenoborgs mehr.

xenoborg-number-xenoborg-alive-end = Anzahl der lebenden Xenoborgs: {$count}
xenoborg-number-crew-alive-end = Anzahl lebender Crewmitglieder: {$count}

xenoborg-max-number = Die höchste Anzahl von Xenoborgs war: {$count}

