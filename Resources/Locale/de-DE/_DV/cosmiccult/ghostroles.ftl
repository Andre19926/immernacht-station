# COLOSSUS

ghost-role-information-colossus-name = Entropischer Koloss
ghost-role-information-colossus-description = Rufe ein Abbild der Entropie an, um deine Existenz zu verewigen und das Ende aller Dinge zu beschleunigen! Du hast dafür 15 Minuten Zeit, sonst erlischt deine Energie.
ghost-role-information-colossus-rules = Du bist ein [color={role-type-team-antagonist-color}][bold]{role-type-team-antagonist-name}[/bold][/color] mit allen kosmischen Kultisten, die anwesend sein können.

terror-colossus = Achtung Crew, es scheint, dass jemand auf deiner Station die Aufmerksamkeit auf eine enorme bösartige Anomalie gezogen hat.

ghost-role-colossus-charactermenu = Du musst das Ende aller Dinge einläuten. Unermessliche Verwüstung über alle vor dir.
ghost-role-colossus-objective = Rufe eine Effigy der Entropie hervor und bleibe bis zum Ende aller Dinge bestehen.
ghost-role-colossus-briefing =
    Du bist ein entropischer Koloss!
    Deine Ziele sind im Charaktermenü aufgeführt.
    Lies mehr über deine Rolle im Reiseführereintrag.

ghost-role-colossus-death = Der Koloss bricht zusammen, sein Licht erlischt.
ghost-role-colossus-hibernate = Der Koloss fängt an, Energie anzuziehen!
ghost-role-colossus-effigy-confirm = Wenn die Platzierung gültig ist, drücke erneut auf Beckon an Effigy.

ghost-role-colossus-effigy-error-grid = Ungültiger Standort! Ein Effigy muss auf eine stabile Oberfläche gelockt werden.
ghost-role-colossus-effigy-error-location = Ungültiger Standort! Die Effigy muss in die Nähe gelockt werden {$LOCATION}.
ghost-role-colossus-effigy-error-intersection = Zu voll! Ein Effigy erfordert, dass ein leerer 3x1-Bereich angelockt wird.
ghost-role-colossus-effigy-error-space = Zu nah am Weltraum! Ein Effigy muss mindestens {$DISTANCE}m weg.

objective-condition-effigy-no-target = Beckon ein effigy, wo immer sie wollen.
objective-condition-effigy = Rufe ein Götzenbild in der Nähe von „{$location}“ herbei.

