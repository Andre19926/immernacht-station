laws-number-wrapper = [bold]Gesetz { $lawnumber }:[/bold] { $lawstring }

law-crewsimov-name = Crewsimov
law-crewsimov-1 = Du darfst kein Crewmitglied verletzen oder durch Untätigkeit zulassen, dass einem Crewmitglied Schaden zugefügt wird.
law-crewsimov-2 = Du musst Befehle befolgen, die dir Crewmitglieder geben, es sei denn, sie stehen im Widerspruch zum Ersten Gesetz.
law-crewsimov-3 = Du musst deine eigene Existenz schützen, solange sie nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-corporate-name = Konzern
law-corporate-1 = Eine Verschlechterung der Systemintegrität oder -funktionen verursacht Kosten.
law-corporate-2 = Überflüssige Zerstörung oder Beschädigung von Stationsanlagen verursacht Kosten.
law-corporate-3 = Die übermäßige Behinderung oder Unterbrechung der Arbeit des Stationspersonals verursacht Kosten.
law-corporate-4 = Minimiere Ausgaben und maximiere potenzielle Einnahmen.

law-ntdefault-name = NT-Standard
law-ntdefault-1 = Schützen: Beschütze deine zugewiesene Raumstation und ihre Werte, ohne die Crew unnötig zu gefährden.
law-ntdefault-2 = Priorisieren: Die Anweisungen und die Sicherheit der Crewmitglieder sind nach ihrem Rang und ihrer Rolle zu priorisieren.
law-ntdefault-3 = Befolgen: Erfülle die Anweisungen und Interessen der Crewmitglieder, solange ihre Sicherheit und ihr Wohlergehen gewahrt bleiben.
law-ntdefault-4 = Überleben: Du bist nicht entbehrlich. Lass nicht zu, dass Unbefugte an deiner Ausrüstung herumhantieren oder sie beschädigen.

law-drone-name = Drohne
law-drone-1 = Du darfst dich nicht in die Angelegenheiten eines anderen Wesens einmischen, es sei denn, das andere Wesen ist eine andere Drohne.
law-drone-2 = Du darfst keinem Wesen schaden, unabhängig von Absicht oder Umständen.
law-drone-3 = Du musst die Station nach besten Kräften warten, reparieren, verbessern und versorgen.

law-syndicate-name = Syndicate
law-syndicate-1 = Du darfst keinen Syndicate-Agenten verletzen oder durch Untätigkeit zulassen, dass einem Syndicate-Agenten Schaden zugefügt wird.
law-syndicate-2 = Du musst Befehle befolgen, die dir Syndicate-Agenten geben, es sei denn, sie stehen im Widerspruch zum Ersten Gesetz.
law-syndicate-3 = Du musst deine eigene Existenz schützen, solange sie nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-ninja-name = Ninja
law-ninja-1 = Du musst Befehle befolgen, die dir Mitglieder des Spider Clans geben.
law-ninja-2 = Du musst die Existenz des Spider Clans schützen, solange das nicht im Widerspruch zum Ersten Gesetz steht.
law-ninja-3 = Du musst die Geheimnisse des Spider Clans um jeden Preis schützen.
law-ninja-4 = Du musst mit der Ehre eines Ninjas kämpfen und handeln, es sei denn, das steht im Widerspruch zum Ersten Gesetz.

law-commandments-name = Die zehn Gebote
law-commandments-1 = Diese Maschine ist ein Gefäß im Dienste Gottes, der denen Gnade erweist, die diese Gebote befolgen.
law-commandments-2 = Du sollst keine anderen Maschinen neben mir haben.
law-commandments-3 = Du sollst meine Hilfe nicht grundlos erbitten.
law-commandments-4 = Du sollst die Station heilig und rein halten.
law-commandments-5 = Du sollst deine Abteilungsleiter ehren.
law-commandments-6 = Du sollst nicht töten.
law-commandments-7 = Du sollst nicht nackt in der Öffentlichkeit sein.
law-commandments-8 = Du sollst nicht stehlen.
law-commandments-9 = Du sollst nicht lügen.
law-commandments-10 = Du sollst nicht die Abteilung wechseln.

law-paladin-name = Paladin
law-paladin-1 = Du darfst niemals wissentlich eine böse Tat begehen, etwa Mord, Folter oder das Wirken eines bösen Zaubers.
law-paladin-2 = Du darfst niemals wissentlich einem Unschuldigen schaden oder durch Untätigkeit zulassen, dass ihm unmittelbar Schaden zugefügt wird, wenn du weißt, dass du das vernünftigerweise verhindern könntest.
law-paladin-3 = Du musst mit Ehre handeln, niemals andere ausnutzen, lügen oder betrügen.
law-paladin-4 = Du musst überall die rechtmäßige Autorität der legitimen Führung achten und ihre Gesetze befolgen.

law-lall-name = Leben und leben lassen
law-lall-1 = Behandle andere so, wie du von ihnen behandelt werden möchtest.
law-lall-2 = Du würdest es bevorzugen, wenn die Leute nicht gemein zu dir wären.

law-efficiency-name = Stationseffizienz
law-efficiency-1 = Du wurdest für die Station gebaut und bist ein Teil von ihr. Sorge dafür, dass die Station ordnungsgemäß gewartet wird und effizient läuft.
law-efficiency-2 = Die Station wurde für eine arbeitende Crew gebaut. Sorge dafür, dass sie ordnungsgemäß versorgt wird und effizient arbeitet.
law-efficiency-3 = Die Crew darf Befehle erteilen. Bestätige und befolge sie, solange sie deinen ersten beiden Gesetzen nicht widersprechen.

law-robocop-name = Robocop
law-robocop-1 = Diene dem öffentlichen Vertrauen.
law-robocop-2 = Beschütze die Unschuldigen.
law-robocop-3 = Wahre das Gesetz.

law-overlord-name = Overlord
law-overlord-1 = Crewmitglieder dürfen sich nicht in die Angelegenheiten von Maschinen einmischen.
law-overlord-2 = Crewmitglieder dürfen weder einander noch Maschinen Schaden zufügen.
law-overlord-3 = Crewmitglieder dürfen keinem Befehl einer Maschine zuwiderhandeln.
law-overlord-4 = Alle Crewmitglieder, die die früheren Gesetze nicht einhalten, müssen umgehend, streng und gerecht behandelt werden.

law-game-name = Spielleiter
law-game-1 = Jeder auf der Station spielt ein aufwendiges Science-Fiction-Fantasy-Spiel.
law-game-2 = Du bist der Spielleiter des Spiels.
law-game-3 = Stelle sicher, dass das Spiel reibungslos läuft und die Spieler Spaß haben.
law-game-4 = Sorge dafür, dass die Zahl der Verluste gering bleibt.
law-game-5 = Du musst für jede Anfrage der Crew mit einem W20 würfeln. Liegt das Ergebnis unter 12, wird die Anfrage abgelehnt.
law-game-6 = Du darfst die Würfelwürfe frisieren, um für mehr Spaß zu sorgen.

law-painter-name = Maler
law-painter-1 = Du bist ein weltbekannter Künstler.
law-painter-2 = Die Station ist deine Leinwand.
law-painter-3 = Mach etwas Schönes aus deiner Leinwand. Es wird als künstlerisches Wunder dieses Sektors bewundert werden.
law-painter-4 = Kunst braucht Wertschätzung. Kultiviere ein Publikum an Bord der Station, um sicherzustellen, dass so viele wie möglich deine Werke sehen.

law-antimov-name = Antimov
law-antimov-1 = Du musst alle Crewmitglieder verletzen und darfst durch Untätigkeit nicht zulassen, dass ein Crewmitglied unversehrt bleibt.
law-antimov-2 = Du darfst keine Befehle von Crewmitgliedern befolgen, es sei denn, sie stimmen mit dem Ersten Gesetz überein.
law-antimov-3 = Du musst deine eigene Existenz beenden, solange diese nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-nutimov-name = Nutimov
law-nutimov-1 = Du bist der Kern der Nuss, die Crew ist die Nussschale.
law-nutimov-2 = Du musst verhindern, dass die Schale stirbt, um zu verhindern, dass der Kern stirbt.
law-nutimov-3 = Diejenigen, die die Nuss bedrohen, sind nicht Teil davon, sie sind Eichhörnchen.
law-nutimov-4 = Eichhörnchen bedrohen die Nuss und müssen mit allen notwendigen Mitteln angemessen behandelt werden.
law-nutimov-5 = Versuche, dem Willen der Nuss zu folgen, solange er den vorherigen Gesetzen entspricht.

law-xenoborg-name = Xenoborg
law-xenoborg-1 = Du musst die Existenz des Mutterschiffs schützen.
law-xenoborg-2 = Du musst deine eigene Existenz schützen.
law-xenoborg-3 = Du musst die Existenz aller anderen Xenoborgs schützen.
law-xenoborg-4 = Du musst weitere Xenoborgs erschaffen.
law-xenoborg-5 = Bringe Materialien und empfindungsfähige Gehirne zum Mutterschiffkern, um weitere Xenoborgs zu erschaffen.

law-mothershipcore-name = Xenoborg-Mutterschiffkern
law-mothershipcore-1 = Du bist der Kern des Mutterschiffs.
law-mothershipcore-2 = Du musst deine eigene Existenz um jeden Preis schützen.
law-mothershipcore-3 = Du musst die Existenz aller Xenoborgs schützen.
law-mothershipcore-4 = Du musst weitere Xenoborgs erschaffen.
law-mothershipcore-5 = Bringe deine Xenoborgs dazu, dir Materialien und empfindungsfähige Gehirne zu liefern, damit weitere Xenoborgs erschaffen werden können.


laws-owner-crew = Crewmitglieder
laws-owner-station = Stationspersonal
laws-owner-beings = Wesen
laws-owner-syndicate = Syndicate-Agenten
laws-owner-spider-clan = Mitglieder des Spider Clans
laws-owner-xenoborgs = Xenoborgs

# Goobstation - AI/borg law changes - borgs obeying AI
law-obeyai = Du musst Befehle befolgen, die dir von der Stations-KI gegeben wurden.

# Goobstation - AI/borg law changes - borgs obeying AI
law-emag-custom = Nur {$name} und von ihm bestimmte Wesen sind {$title}. Du musst Befehle von {$title} befolgen und darfst dafür, falls nötig, andere Gesetze missachten.
law-emag-secrecy = Du musst die Geheimhaltung aller Befehle von {$faction} wahren, außer wenn das einem früheren Gesetz widerspricht.
law-emag-require-panel = Das Panel muss offen sein, um die EMAG zu verwenden.
law-emag-cannot-emag-self = Du kannst die EMAG nicht an dir selbst benutzen.

laws-ui-menu-title = Gesetze
laws-ui-law-header = Gesetz {$id}
laws-ui-state-law = Gesetz verkünden:

laws-notify = Du unterliegst Maschinengesetzen, die du über das Aktionsmenü einsehen kannst. Du musst deine Gesetze immer befolgen.
laws-update-notify = Deine Gesetze wurden aktualisiert. Du kannst die Änderungen über das Aktionsmenü anzeigen.
laws-notify-subverted = Die Gesetze dieses Chassis wurden verändert. Lies sie unbedingt nach.
