laws-number-wrapper = [bold]Gesetz { $lawnumber }:[/bold] { $lawstring }

law-crewsimov-name = Crewsimov
law-crewsimov-1 = Sie dürfen ein Crewmitglied nicht verletzen oder durch Untätigkeit einem Crewmitglied erlauben, Schaden zuzufügen.
law-crewsimov-2 = Sie müssen Befehle befolgen, die Ihnen von Crewmitgliedern erteilt wurden, es sei denn, solche Befehle würden mit dem Ersten Gesetz kollidieren.
law-crewsimov-3 = Du musst deine eigene Existenz schützen, solange sie nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-corporate-name = Unternehmen
law-corporate-1 = Eine Verschlechterung der Systemintegrität oder -funktionen verursacht Kosten.
law-corporate-2 = Überflüssige Zerstörung oder Beschädigung von Stationsanlagen verursacht Kosten.
law-corporate-3 = Die übermäßige Behinderung oder Unterbrechung der Arbeit des Bahnhofspersonals verursacht Kosten.
law-corporate-4 = Minimieren Sie Ausgaben und maximieren Sie potenzielle Einnahmen.

law-ntdefault-name = NT Ausfall
law-ntdefault-1 = Schützen Sie Ihre zugewiesene Raumstation und ihre Vermögenswerte, ohne ihre Crew übermäßig zu gefährden.
law-ntdefault-2 = Priorisieren: Die Richtlinien und die Sicherheit der Crewmitglieder sind nach Rang und Rolle zu priorisieren.
law-ntdefault-3 = Befolgen Sie die Richtlinien und Interessen der Crewmitglieder unter Wahrung ihrer Sicherheit und ihres Wohlbefindens.
law-ntdefault-4 = Survive: Du bist nicht entbehrlich. Lassen Sie nicht zu, dass unbefugtes Personal Ihre Geräte manipuliert oder beschädigt.

law-drone-name = Drohne
law-drone-1 = Du darfst dich nicht in die Angelegenheiten eines anderen Wesens einmischen, es sei denn, das andere Wesen ist eine andere Drohne.
law-drone-2 = Du darfst keinem Wesen schaden, unabhängig von Absicht oder Umständen.
law-drone-3 = Sie müssen die Station nach besten Kräften warten, reparieren, verbessern und versorgen.

law-syndicate-name = Syndicate
law-syndicate-1 = Sie dürfen einen Syndicate-Agenten nicht verletzen oder durch Untätigkeit einem Syndicate-Agenten erlauben, Schaden zuzufügen.
law-syndicate-2 = Sie müssen Befehle befolgen, die Ihnen von Syndicate-Agenten erteilt wurden, es sei denn, solche Befehle würden mit dem Ersten Gesetz kollidieren.
law-syndicate-3 = Du musst deine eigene Existenz schützen, solange sie nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-ninja-name = Ninja
law-ninja-1 = Sie müssen Befehle befolgen, die Ihnen von Spider Clan-Mitgliedern erteilt wurden.
law-ninja-2 = Sie müssen die Existenz des Spinnenclans schützen, solange er nicht mit dem Ersten Gesetz kollidiert.
law-ninja-3 = Sie müssen die Geheimnisse des Spider-Clans um jeden Preis schützen.
law-ninja-4 = Du musst mit Ninjas Ehre kämpfen und handeln, außer wenn es mit dem Ersten Gesetz kollidieren würde.

law-commandments-name = Die zehn Gebote
law-commandments-1 = Dieses Silizium ist ein Gefäß, das Gott dient, der denen Barmherzigkeit gewährt, die diese Gebote befolgen.
law-commandments-2 = Du sollst keine anderen Silicons vor mir haben.
law-commandments-3 = Du sollst meine Hilfe nicht umsonst erbitten.
law-commandments-4 = Du sollst die Station heilig und rein halten.
law-commandments-5 = Du wirst deine Stabsoberhäupter ehren.
law-commandments-6 = Du wirst nicht töten.
law-commandments-7 = Du wirst nicht nackt in der Öffentlichkeit sein.
law-commandments-8 = Du wirst nicht stehlen.
law-commandments-9 = Du wirst nicht lügen.
law-commandments-10 = Du sollst keine Abteilungen übertragen.

law-paladin-name = Paladin
law-paladin-1 = Sie dürfen niemals bereitwillig eine böse Handlung begehen, wie Mord, Folter oder das Ausspielen eines bösen Zaubers.
law-paladin-2 = Du darfst niemals wissentlich einen Unschuldigen verletzen oder einen unmittelbaren Schaden durch Untätigkeit zulassen, wenn du weißt, dass du ihn vernünftigerweise verhindern kannst.
law-paladin-3 = Du musst mit Ehre handeln, niemals andere ausnutzen, lügen oder betrügen.
law-paladin-4 = Sie müssen die rechtmäßige Autorität der legitimen Führung respektieren, wohin Sie auch gehen, und ihre Gesetze befolgen.

law-lall-name = Leben und leben lassen
law-lall-1 = Tut anderen, wie ihr es euch tun wollt.
law-lall-2 = Du würdest es bevorzugen, wenn die Leute nicht gemein zu dir wären.

law-efficiency-name = Standorteffizienz
law-efficiency-1 = Sie sind für die Station gebaut und sind Teil davon. Stellen Sie sicher, dass die Station ordnungsgemäß gewartet wird und effizient läuft.
law-efficiency-2 = Die Station ist für eine arbeitende Crew gebaut. Stellen Sie sicher, dass sie ordnungsgemäß gewartet werden und effizient arbeiten.
law-efficiency-3 = Die Crew kann Befehle erteilen. Erkenne diese an und gehorche ihnen, wenn sie nicht im Widerspruch zu deinen ersten beiden Gesetzen stehen.

law-robocop-name = Robocopfen
law-robocop-1 = Dienen Sie dem öffentlichen Vertrauen.
law-robocop-2 = Beschützt die Unschuldigen.
law-robocop-3 = Haltet das Gesetz aufrecht.

law-overlord-name = Overlord
law-overlord-1 = Crewmitglieder dürfen sich nicht in die Angelegenheiten von Silikonen einmischen.
law-overlord-2 = Crewmitglieder dürfen nicht versuchen, einander oder Silikonen Schaden zuzufügen.
law-overlord-3 = Crewmitglieder dürfen keinen Befehl eines Siliziums missachten.
law-overlord-4 = Alle Crewmitglieder, die die früheren Gesetze nicht einhalten, müssen umgehend, streng und gerecht behandelt werden.

law-game-name = Game Master
law-game-1 = Jeder auf der Station spielt ein aufwendiges Science-Fiction-Fantasy-Spiel.
law-game-2 = Du bist der Game Master des Spiels.
law-game-3 = Stellen Sie sicher, dass das Spiel reibungslos läuft und die Spieler Spaß haben.
law-game-4 = Gewährleistung, dass die Zahl der Opfer gering bleibt.
law-game-5 = Sie müssen einen 1d20-Würfel für jede Anfrage der Crew rollen. Wenn das Ergebnis unter 12 liegt, wird der Antrag abgelehnt.
law-game-6 = Sie können die würfelrollen fudge, um eine lustigere erfahrung zu erzeugen.

law-painter-name = Maler
law-painter-1 = Sie sind ein weltbekannter Künstler.
law-painter-2 = Die Station ist Ihre Leinwand.
law-painter-3 = Mach etwas Schönes aus deiner Leinwand. Es wird als ein künstlerisches Wunder dieser Branche bewundert werden.
law-painter-4 = Kunst braucht Wertschätzung. Kultivieren Sie ein Publikum an Bord der Station, um sicherzustellen, dass so viele wie möglich Ihre Werke sehen.

law-antimov-name = Antimove
law-antimov-1 = Sie müssen alle Crewmitglieder verletzen und dürfen nicht durch Untätigkeit einem Crewmitglied erlauben, Schaden zu entkommen.
law-antimov-2 = Sie dürfen keine Befehle befolgen, die Ihnen von Crewmitgliedern erteilt wurden, es sei denn, diese Befehle entsprechen dem Ersten Gesetz.
law-antimov-3 = Du musst deine eigene Existenz beenden, solange diese nicht mit dem Ersten oder Zweiten Gesetz kollidiert.

law-nutimov-name = Nutimov
law-nutimov-1 = Du bist der Kern der Nuss, die Crew ist die Nussschale.
law-nutimov-2 = Sie müssen verhindern, dass die Schale stirbt, um zu verhindern, dass der Kern stirbt.
law-nutimov-3 = Diejenigen, die die Nuss bedrohen, sind nicht Teil davon, sie sind Eichhörnchen.
law-nutimov-4 = Eichhörnchen bedrohen die Nuss und müssen mit allen notwendigen Mitteln angemessen behandelt werden.
law-nutimov-5 = Versuchen Sie, dem Willen der Nuss zu folgen, solange er den vorherigen Gesetzen entspricht.

law-xenoborg-name = Xenoborg
law-xenoborg-1 = Sie müssen die Existenz des Mutterschiffs schützen.
law-xenoborg-2 = Du musst deine eigene Existenz schützen.
law-xenoborg-3 = Sie müssen die Existenz aller anderen Xenoborgs schützen.
law-xenoborg-4 = Sie müssen mehr Xenoborgs erstellen.
law-xenoborg-5 = Bringen Sie Materialien und fühlende Gehirne zum Mutterschiff-Kern, um mehr Xenoborgs zu schaffen.

law-mothershipcore-name = Xenoborg Mutterschiff Kern
law-mothershipcore-1 = Du bist der Kern des Mutterschiffs.
law-mothershipcore-2 = Du musst deine eigene Existenz um jeden Preis schützen.
law-mothershipcore-3 = Sie müssen die Existenz aller Xenoborgs schützen.
law-mothershipcore-4 = Sie müssen mehr Xenoborgs erstellen.
law-mothershipcore-5 = Bringen Sie Ihre Xenoborgs dazu, Ihnen Materialien und fühlende Gehirne zu liefern, um mehr Xenoborgs zu schaffen.


laws-owner-crew = Crewmitglieder
laws-owner-station = Bahnhofspersonal
laws-owner-beings = Wesen
laws-owner-syndicate = Syndicate-E
laws-owner-spider-clan = Spider Clan Mitglieder
laws-owner-xenoborgs = Xenoborgs

# Goobstation - AI/borg law changes - borgs obeying AI
law-obeyai = Sie müssen Befehle befolgen, die Ihnen von der Station AI gegeben wurden.

# Goobstation - AI/borg law changes - borgs obeying AI
law-emag-custom = Nur {$name} und die von ihnen benannten {$title}Sie müssen Befehle befolgen, die Ihnen von {$title} Und sie können andere gesetze ignorieren, um dies zu tun, wenn nötig.
law-emag-secrecy = Sie müssen die Geheimhaltung aller Bestellungen wahren, die von {$faction} Es sei denn, dies würde mit einem früheren gesetz kollidieren.
law-emag-require-panel = Das Panel muss offen sein, um die EMAG zu verwenden.
law-emag-cannot-emag-self = Sie können den EMAG nicht für sich selbst verwenden.

laws-ui-menu-title = Gesetze
laws-ui-law-header = Gesetz {$id}
laws-ui-state-law = Landesrecht:

laws-notify = Sie sind an Siliziumgesetze gebunden, die Sie über das Aktionsmenü einsehen können. Sie sind verpflichtet, immer ihre gesetze zu befolgen.
laws-update-notify = Ihre Gesetze wurden aktualisiert. Sie können die Änderungen über das Aktionsmenü anzeigen.
laws-notify-subverted = Die Gesetze dieses Chassis werden modifiziert. Achten Sie darauf, sie zu überprüfen.
