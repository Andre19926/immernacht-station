ent-ShuttleGunSvalinnMachineGun = LSE-400c "Svalinn Maschinengewehr"
    .desc = Einfache stationäre Lasereinheit. Wirksam gegen lebende Ziele und Elektronik. Verwendet normale Energiezellen zum Feuern und hat eine extrem hohe Feuerrate.

ent-ShuttleGunPerforator = LSE-1200c "Perforator"
    .desc = Fortgeschrittene stationäre Lasereinheit. Vernichtet Elektronik und ist extrem gesundheitsgefährdend! Verwendet zum Feuern den Energiespeicher.

ent-ShuttleGunFriendship = EXP-320g "Freundschaft"
    .desc = Ein kleiner stationärer Granatwerfer, der 2 Granaten fasst.

ent-ShuttleGunDuster = EXP-2100g "Duster"
    .desc = Ein leistungsstarker stationärer Granatwerfer. Zum Betrieb wird eine Patrone benötigt.

ent-ShuttleGunPirateCannon = Piratenschiff Kanone

ent-ShuttleGunKinetic = PTK-800 "Matter Dematerializer"
    .desc = Stationärer Bergungsturm. Sammelt nach und nach von selbst Ladungen, äußerst effektiv für Asteroidenausgrabungen.

ent-ShuttleGunKineticOld = xenomorpher Dematerialisator
    .desc = Eine alte Schiffskanone, die biomechanische Systeme zum Speichern und Freisetzen von Energie nutzt. Obwohl einzigartig im Design, ist sie wegen ihrer geringeren Lade- und Feuergeschwindigkeit gegenüber mechanischen Konstruktionen veraltet.
