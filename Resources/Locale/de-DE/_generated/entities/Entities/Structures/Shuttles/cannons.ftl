ent-ShuttleGunSvalinnMachineGun = LSE-400c "Svalinn Maschinengewehr"
    .desc = Grundlegende stationäre Lasereinheit. Wirksam gegen Live-Ziele und Elektronik. Verwendet normale Kraftzellen zum Feuern und hat eine extrem hohe Feuerrate.

ent-ShuttleGunPerforator = LSE-1200c "Perforator"
    .desc = Fortgeschrittene stationäre Lasereinheit. Vernichtet Elektronik und ist extrem gefährlich für die Gesundheit! Benutzt den Power Cage zum Feuern.

ent-ShuttleGunFriendship = EXP-320g "Freundschaft"
    .desc = Ein kleiner stationärer Granatwerfer, der 2 Granaten hält.

ent-ShuttleGunDuster = EXP-2100g "Duster"
    .desc = Ein leistungsstarker stationärer Granatwerfer. Für den Einsatz ist eine Patrone erforderlich.

ent-ShuttleGunPirateCannon = Piratenschiff Kanone

ent-ShuttleGunKinetic = PTK-800 "Matter Dematerializer"
    .desc = Salvage-Turm stationär. Allmählich sammelt Ladungen auf eigene Faust, äußerst effektiv für Asteroidenausgrabungen.

ent-ShuttleGunKineticOld = xenomorpher Dematerialisator
    .desc = Eine alte Schiffskanone, die biomechanische Systeme verwendet, um Energie zu speichern und freizusetzen. Obwohl es in seinem Design einzigartig ist, wurde es aufgrund seiner geringeren Lade- und Zündgeschwindigkeit im Vergleich zu mechanischen Konstruktionen veraltet.
