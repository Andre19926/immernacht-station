ent-MopItem = Mohn
    .desc = Ein unaufhaltsamer Wischmopp, die Innereien-Beseitigung wartet.

ent-AdvMopItem = Fortgeschrittener Mopp
    .desc = Motorisierter Wischmopp mit größerem Tank, der Reagenzien im Inneren schnell durch Wasser ersetzt. Automatische Clown-Gegenmaßnahme nicht inbegriffen.

ent-WetFloorSign = Nassbodenschild
    .desc = Vorsicht! Nasser Boden!

ent-WetFloorSignMineExplosive = Nassbodenschild
    .desc = Vorsicht! Nasser Boden!

