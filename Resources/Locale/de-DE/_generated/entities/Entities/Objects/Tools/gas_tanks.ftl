ent-OxygenTank = Sauerstoffbehälter
    .desc = Ein zylindrischer Standardgasbehälter für Sauerstoff. Er fasst 5 l Gas.

ent-NitrogenTank = Stickstoffbehälter
    .desc = Ein zylindrischer Standardgasbehälter für Stickstoff. Er fasst 5 l Gas.

ent-EmergencyOxygenTank = Sauerstoffnottank
    .desc = Ein leicht tragbarer Tank für Notfälle. Enthält sehr wenig Sauerstoff, nur für das Überleben bestimmt. Er fasst 0,66 l Gas.

ent-EmergencyNitrogenTank = Stickstoffnottank
    .desc = Ein leicht tragbarer Tank für Notfälle. Enthält sehr wenig Stickstoff, nur für das Überleben bestimmt. Er fasst 0,66 l Gas.

ent-ExtendedEmergencyOxygenTank = erweiterter Notfall-Sauerstofftank
    .desc = Ein Nottank mit erweiterter Kapazität, für längere Nutzung ausgelegt. Er fasst 1,5 l Gas.

ent-ExtendedEmergencyNitrogenTank = erweiterter Notstickstofftank
    .desc = Ein Nottank mit erweiterter Kapazität, für längere Nutzung ausgelegt. Er fasst 1,5 l Gas.

ent-DoubleEmergencyOxygenTank = Doppelter Notfall-Sauerstofftank
    .desc = Ein hochwertiger Doppeltank für Notfälle. Er hält eine anständige Menge an Sauerstoff für seine geringe Größe. Er fasst 2,5 l Gas.

ent-DoubleEmergencyNitrogenTank = Doppelter Notstickstofftank
    .desc = Ein hochwertiger Doppeltank für Notfälle. Er hält eine anständige Menge an Stickstoff für seine geringe Größe. Er fasst 2,5 l Gas.

ent-EmergencyFunnyOxygenTank = Lustiger Notfall-Sauerstofftank
    .desc = Ein leicht tragbarer Notfalltank. Enthält sehr wenig Sauerstoff mit einem Extra an Lachgas, nur zum Überleben gedacht. Er fasst 0,66 l Gas.

ent-AirTank = Luftbehälter
    .desc = Mal was Frisches? Fasst 5 l Gas.

ent-NitrousOxideTank = Lachgasbehälter
    .desc = Enthält eine Mischung aus Luft und Lachgas. Fülle ihn nicht mit reinem N2O nach. Er fasst 5 l Gas.

ent-PlasmaTank = Plasmatank
    .desc = Enthält gefährliches Plasma. Nicht einatmen, es sei denn, du bist ein Plasmaman. Extrem entzündlich. Er fasst 5 l Gas.
