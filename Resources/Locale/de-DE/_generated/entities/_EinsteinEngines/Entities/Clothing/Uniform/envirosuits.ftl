ent-ClothingUniformEnvirosuitMantis = Mantis-Umweltanzug
    .desc = Jagd auf Psionik in der Sicherheit dieses Umweltanzugs.

ent-ClothingUniformEnvirosuitSafari = Safari-Umweltanzug
