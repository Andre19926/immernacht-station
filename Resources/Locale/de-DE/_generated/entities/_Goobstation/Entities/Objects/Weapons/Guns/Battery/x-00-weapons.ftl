ent-WeaponHeadOfSecurityRifle = X-8 "Station Sweeper"
    .desc = Ein aufwendig gestaltetes Gewehr, das Schüsse aus reinem Phoron abfeuert. Niedrige Feuerrate, hoher Schaden.

ent-WeaponHeadOfSecuritySMG = X-6 "Threadripper"
    .desc = Eine aufwendig gestaltete SMG, die Schüsse aus reinem Phoron abfeuert. Erstaunlich für das ablegen von unterdrückendem feuer.

ent-WeaponHeadOfSecurityShotgun = X-12 "Flamberge"
    .desc = Eine aufwendig gestaltete Schrotflinte, die Schüsse aus reinem Phoron abfeuert. Gebaut, um Abwehrkräfte abzubauen, und es macht diesen Job gut.

ent-WeaponHeadOfSecuritySniper = X-18 "Ranought"
    .desc = Ein aufwendig gestaltetes Scharfschützengewehr, das Schüsse aus reinem Phoron abfeuert. Du willst nicht davon getroffen werden.
