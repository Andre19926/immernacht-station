ent-WeaponHeadOfSecurityRifle = X-8 "Station Sweeper"
    .desc = Ein aufwendig gestaltetes Gewehr, das Schüsse aus reinem Phoron abfeuert. Niedrige Feuerrate, hoher Schaden.

ent-WeaponHeadOfSecuritySMG = X-6 "Threadripper"
    .desc = Eine aufwendig gestaltete SMG, die Schüsse aus reinem Phoron abfeuert. Hervorragend für Sperrfeuer.

ent-WeaponHeadOfSecurityShotgun = X-12 "Flamberge"
    .desc = Eine aufwendig gestaltete Schrotflinte, die Schüsse aus reinem Phoron abfeuert. Gebaut, um Verteidigungsanlagen niederzureißen, und sie macht ihre Arbeit gut.

ent-WeaponHeadOfSecuritySniper = X-18 "Ranought"
    .desc = Ein aufwendig gestaltetes Scharfschützengewehr, das Schüsse aus reinem Phoron abfeuert. Von dem willst du nicht getroffen werden.
