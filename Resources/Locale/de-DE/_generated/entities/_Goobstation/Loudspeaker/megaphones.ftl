ent-Megaphone = Megaphon
    .desc = Testen!

ent-CargoMegaphone = Fracht Megaphone
    .desc = Mache Geld in der Stille und lass die Hektik Lärm machen. Oder so etwas.

ent-CommandMegaphone = Führungs-Megaphon
    .desc = Verwandeln dich oberflächliche Autorität in laute oberflächliche Autorität.

ent-SecurityMegaphone = Sicherheits-Megaphon
    .desc = Verwende, um Verdächtige darauf aufmerksam zu machen, dass du hinter ihnen her bist. Oder um Gefangene anzuschreien, die man nicht mag.

ent-ClownMegaphone = Clown Megafon
    .desc = Ein Komiker muss seine Stimme bekannt machen.
