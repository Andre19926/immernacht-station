ent-Megaphone = Megaphon
    .desc = Testen!

ent-CargoMegaphone = Fracht Megaphone
    .desc = Machen Sie Geld in der Stille und lassen Sie die Hektik Lärm machen. Oder so etwas.

ent-CommandMegaphone = Führungs-Megaphon
    .desc = Verwandeln Sie oberflächliche Autorität in laute oberflächliche Autorität.

ent-SecurityMegaphone = Sicherheits-Megaphon
