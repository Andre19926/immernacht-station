# addaction
cmd-addaction-desc = Fügt der Ziel-Entity eine Aktion hinzu. Die Aktion funktioniert nicht, wenn die Ziel-Entity eine zusätzliche Komponente benötigt (zum Beispiel das Verschlingen des Drachen).
cmd-addaction-help = addition <EntityUid> <ActionPrototype>

cmd-addaction-invalid-args = Es werden genau 2 Argumente erwartet.
cmd-addaction-actions-not-found = Die Ziel-Entity kann keine Aktionen verwenden.
cmd-addaction-action-not-found = Es wurde kein passender Aktions-Prototyp {$action} gefunden.
cmd-addaction-adding-failed = Die Aktion konnte nicht hinzugefügt werden.

cmd-addaction-player-completion = <EntityUid>
cmd-addaction-action-completion = <ActionProto>
