dynamic-gamerule-wizard-title = [color=cyan]Zauberer[/color]

objective-issuer-wizard-federation = [color=cyan]Space Wizard Federation[/color]

wizard-role-greeting =
    Du bist ein mächtiger Weltraum-Zauberer. Ihr Ziel ist es, so viel Chaos wie möglich auf {$station}und überleben. Die Space Wizard Federation hat Ihnen magische Zauberer-Grimoire zur Verfügung gestellt, mit denen Sie verheerende Zaubersprüche lernen können.

wizard-role-briefing = Du bist ein Weltraummagier. Überlebe und verwüste die Simpletons.
apprentice-role-briefing = Du bist ein Weltraum-Zauberlehrling. Bewahre, wer dich am Leben gerufen hat.

wizard-title = Zauberer
wizard-description = Ein mächtiger Weltraum-Assistent besucht die Station. Umarme das Chaos.

lich-greeting =
    Mit einem abscheulichen Gefühl der Leere siehst du in entsetzter Faszination zu, wie die Haut von den Knochen abfällt! Blut kocht, Nerven zerfallen, Augen kochen in ihren Sockeln! Wenn Ihre Organe in Ihrer fleischlosen Brust zu Staub zerfallen, kommen Sie mit Ihrer Wahl zurecht.
    Du bist ein Lisch.

objective-condition-wizard-alive-title = Wizard sicherstellen {$targetName} bleibt am Leben.
