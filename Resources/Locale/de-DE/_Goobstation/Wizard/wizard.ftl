roles-antag-wizard-name = Zauberer
roles-antag-wizard-description = Verursacht Chaos und Zerstörung auf der Station.

roles-antag-apprentice-name = Lehrling
roles-antag-apprentice-description = Hilf dem Zauberer, der dich gerufen hat, und halte ihn am Leben.

wizard-roundend-name = Zauberer
apprentice-roundend-name = Zauberlehrling

roles-wizard-name = Zauberer
roles-wizard-objective = Verursacht Chaos und Zerstörung auf der Station.

dynamic-gamerule-wizard-title = [color=cyan]Zauberer[/color]

objective-issuer-wizard-federation = [color=cyan]Föderation der Weltraumzauberer[/color]

wizard-role-greeting = Du bist ein mächtiger Weltraumzauberer. Dein Ziel: so viel Chaos wie möglich auf {$station} anzurichten und zu überleben. Die Space Wizard Federation hat dir ein magisches Grimoire gegeben, mit dem du verheerende Zauber lernst.

wizard-role-briefing = Du bist ein Weltraumzauberer. Überlebe und sorge unter den Einfaltspinseln für Verwüstung.
apprentice-role-briefing = Du bist ein Weltraum-Zauberlehrling. Halte den am Leben, der dich gerufen hat.

wizard-title = Zauberer
wizard-description = Ein mächtiger Weltraumzauberer stattet der Station einen Besuch ab. Heiße das Chaos willkommen.

lich-greeting =
    Mit einem abscheulichen Gefühl der Leere siehst du in entsetzter Faszination zu, wie die Haut von den Knochen abfällt! Blut kocht, Nerven zerfallen, Augen kochen in ihren Sockeln! Wenn deine Organe in deiner fleischlosen Brust zu Staub zerfallen, komm mit deiner Wahl zurecht.
    Du bist ein Lisch.

objective-condition-wizard-alive-title = Sorge dafür, dass der Zauberer {$targetName} am Leben bleibt.
