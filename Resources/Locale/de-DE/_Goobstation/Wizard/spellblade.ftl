spellblade-examine-enchantment = Es ist durchdrungen von {$name} Verzauberung.
spellblade-already-enchanted-message = Schon verzaubert!

spellblade-enchantment-lightning-name = [color=lightblue]Blitze[/color]
spellblade-enchantment-lightning-desc = Blitze. Diese Klinge leitet arkane Energie zwischen ihren Opfern. Es macht auch den Benutzer immun gegen Schocks.

spellblade-enchantment-fire-name = [color=orange]Feuer[/color]
spellblade-enchantment-fire-desc = Feuer. Diese Klinge entzündet sich, wenn sie einen Feind trifft und einen Feuerball freigibt. Es macht auch den Träger immun gegen Feuer.

spellblade-enchantment-bluespace-name = [color=blue]Blauraum[/color]
spellblade-enchantment-bluespace-desc = Blauraum. Diese Klinge wird das Gewebe des Raumes durchschneiden und ihren Träger über lange Strecken transportieren, um Feinde zu treffen.

spellblade-enchantment-spacetime-name = [color=pink]Raumzeit[/color]
spellblade-enchantment-spacetime-desc = Raumzeit. Diese Klinge schneidet schneller, aber schwächer und verflucht das Ziel und schneidet sie einige Sekunden, nachdem sie nicht bei jedem Treffer angeschwemmt wurden.

spellblade-enchantment-forceshield-name = [color=cyan]Schutzschirm[/color]
spellblade-enchantment-forceshield-desc = Schutzschild. Diese Klinge wird Sie teilweise gegen Angriffe und Betäubungen für eine kurze Zeit nach dem Schlagen eines Feindes abschirmen.
