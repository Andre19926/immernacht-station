loneop-welcome =
    You are a nuclear operative. Your goal is to blow up {$station}, and ensure that it is nothing but a pile of rubble. Your bosses, the Syndicate, have provided you with the tools you'll need for the task, besides a team.
    Operation {$name} is a go! Good luck!
loneop-briefing = Deine Ziele sind einfach. Liefern dich die Nutzlast und stelle sicher, dass sie detoniert. Beginn der Mission.

loneop-opsmajor = [color=crimson]Großer Sieg für das Syndicate![/color]
loneop-opsminor = [color=crimson]Kleiner Sieg für das Syndicate![/color]
loneop-neutral = [color=yellow]Neutrales Ergebnis![/color]
loneop-crewminor = [color=green]Kleiner Sieg für die Crew![/color]
loneop-crewmajor = [color=green]Großer Sieg für die Crew![/color]

loneop-cond-nukeexplodedoncorrectstation = Der einsame Agent schaffte es, die Station zu sprengen.
loneop-cond-nukeexplodedonincorrectlocation = Die Nuke wurde außerhalb der Station gezündet.
loneop-cond-nukeactiveinstation = Die Nuke wurde bewaffnet auf der Station gelassen.
loneop-cond-nukeactiveatcentcom = Der einsame Agent lieferte die Nuke an das CentComm! Heilige Scheiße!
loneop-cond-nukediskoncentcom = Die Crew entkam mit der nuklearen Authentifizierungsscheibe.
loneop-cond-nukedisknotoncentcom = Die Crew ließ die nukleare Authentifizierungsscheibe zurück.
loneop-cond-nukiesabandoned = Die Atomarbeiter wurden aufgegeben.
loneop-cond-allnukiesdead = Der einsame Aktivist starb.
loneop-cond-allnukiesalive = Der einsame Agent überlebte.

loneop-list-start = Die einsamen Agenten waren:
loneop-list-name = - [color=White]{$name}[/color]
loneop-list-name-user = - [color=White]{$name}[/color] ([color=gray]{$user}[/color])

