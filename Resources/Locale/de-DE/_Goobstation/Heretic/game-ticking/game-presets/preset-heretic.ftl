heretic-roundend-name = ein Ketzer

roundend-prepend-heretic-ascension-success = {$name}, [color=green] ist aufgestiegen![/color]
roundend-prepend-heretic-ascension-fail = {$name}, [color=red] ist gescheitert![/color]
roundend-prepend-heretic-ascension-fail-owls = {$name}, [color=red] hat ihren Aufstieg aufgegeben und ist somit gescheitert![/color]
roundend-prepend-heretic-knowledge-named = [color=white]{$name}[/color] recherchiert hat insgesamt [color=purple]{$number}[/color] Wissen.

heretic-gamemode-title = Ketzer
heretic-gamemode-description =
    Dimensionale Anomalie innerhalb der Station erkannt. Es gibt keine zusätzlichen Daten.

heretic-role-greeting-fluff =
    Ein weiterer Tag in einem sinnlosen Job. Du spürst einen Schimmer um dich herum, während sich eine Erkenntnis von etwas Seltsamem in der Luft entfaltet. Du schaust nach innen und entdeckst etwas, das dein Leben verändern wird.

    Die Tore von Mansus öffnen sich deinem Geist.

heretic-role-greeting =
    Du bist der Ketzer!

    Lies mehr über deine Rolle im Guidebook.

heretic-role-greeting-short =
    Du bist der Ketzer!
    Um das letzte Ritual und Aufstieg zu lernen, musst du deine Aufgaben erfüllen.

## ghoul
heretic-ghoul-greeting =
    Du wurdest von {CAPITALIZE(THE($ent))} in diese Welt gerufen!
    Du musst ihnen auf ihrem Weg zum Aufstieg helfen und sie um jeden Preis beschützen.
    Du darfst anderen Ketzern folgen, wenn dein Meister nicht mehr wiederbelebt werden kann.
heretic-ghoul-greeting-noname =
    Du wurdest von unheimlichen Mächten in diese Welt gerufen.
    Befolge die Befehle deiner Meister, egal was passiert.
heretic-ghoul-briefing-start =
    Du bist in diese Welt gerufen worden, {CAPITALIZE(THE($ent))}!
heretic-ghoul-briefing-start-noname = Du wurdest von unheimlichen Mächten in diese Welt gerufen.
heretic-ghoul-briefing-end =
    Befolge die Befehle deiner Meister, egal was passiert.

    Verwenden sie +m-schlüssel im chat, um auf den mansus-link zuzugreifen.

ghostrole-ghoul-name = Ghoul
ghostrole-flesh-mimic-name = Fleischmimik
ghostrole-prophet-name = Roher Prophet
ghostrole-stalker-name = Stalker
ghostrole-fire-shark-name = Feuerhai
ghostrole-rustwalker-name = Rust Walker
ghostrole-stargazer-name = Star Gazer
ghostrole-ghoul-desc = Hilf deinem Beschwörer, den Aufstieg zu erreichen.
ghostrole-flesh-mimic-desc = Hilf deinem Beschwörer, den Aufstieg zu erreichen. Sei dir bewusst, dass du mit der Zeit stirbst.
ghostrole-prophet-desc = Hilf deinem Beschwörer, den Aufstieg zu erreichen. Verbinde andere Gläubige mit dem Mansus Link. Heile passiv Ketzer und eldritch Kreaturen.
ghostrole-stalker-desc = Teleportiere dich und sabotiere die Beleuchtung der Crew.
ghostrole-fire-shark-desc = Hilf deinem Beschwörer, den Aufstieg zu erreichen. Verbrennt eure Opfer.
ghostrole-rustwalker-desc = Hilf deinem Beschwörer, den Aufstieg zu erreichen. Rost überall verteilen.
ghostrole-stargazer-desc = Hilf deinem Beschwörer, überall Chaos anzurichten.
ghostrole-ghoul-rules = Du bist ein [color=red][bold]Teamantagonist[/bold][/color] mit dem, der dich und andere ältere Wesen gerufen hat.
