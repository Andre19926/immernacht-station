trait-scottish-name = Schottischer Akzent
trait-scottish-desc = Dein schottischer Stolz ist so stark wie dein Akzent!

trait-wheelchair-bound-name = Rollstuhl gebunden
trait-wheelchair-bound-desc = Sie können sich nicht ohne Rollstuhl bewegen. Rollstuhl inklusive.

trait-bogan-name = Boganischer Akzent
trait-bogan-desc = Du hast das von einer mythischen Kreatur gelernt.

poor-vision-trait-examined = [color=lightblue]{CAPITALIZE(POSS-ADJ($target))} Die Augen sind unscharf. Es scheint nicht wie {SUBJECT($target)} Ich kann dich ohne Brille sehr gut sehen.[/color]

trait-medieval-accent-name = Mittelalterlicher Akzent
trait-medieval-accent-desc = Hark! Deine Art o 'Sprache, 'tis ungewöhnlichsten!
trait-tile-movement-name = innerer Frieden
trait-tile-movement-desc = Du bist immer in Kontakt mit deinen Wurzeln. Und mit deinen Wurzeln meine ich die Mitte der Fliese, auf der du stehst.

trait-movement-impaired-name = Bewegung beeinträchtigt
trait-movement-impaired-desc = Sie können nicht ganz scheinen, sehr gut zu gehen, ohne einige Hilfe. Zuckerrohr eingeschlossen.

movement-impaired-trait-examined = [color=yellow]{CAPITALIZE(SUBJECT($target))} Es scheint mit einem leichten Hinken zu laufen. Es scheint nicht wie {SUBJECT($target)} Kann ohne Hilfe sehr gut laufen[/color]

trait-social-anxiety-name = Soziale Angst
trait-social-anxiety-disc = Du hast lähmende soziale Ängste, du bist ausgeflippt von liebevollen Dingen wie Umarmungen.

trait-deaf-name = Taub
trait-deaf-disc =  Du bist völlig taub, du kannst nichts hören, auch nicht dich selbst!
