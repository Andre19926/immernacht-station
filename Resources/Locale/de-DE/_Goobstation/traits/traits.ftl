trait-scottish-name = Schottischer Akzent
trait-scottish-desc = Dein schottischer Stolz ist so stark wie dein Akzent!

trait-wheelchair-bound-name = Rollstuhlpflichtig
trait-wheelchair-bound-desc = Du kannst dich ohne Rollstuhl nicht fortbewegen. Rollstuhl inklusive.

trait-bogan-name = Bogan-Akzent
trait-bogan-desc = Das hast du von einem Fabelwesen gelernt.

poor-vision-trait-examined = [color=lightblue]{CAPITALIZE(POSS-ADJ($target))} Augen sind unscharf. Es scheint, als könnte {SUBJECT($target)} ohne Brille nicht gut sehen.[/color]

trait-medieval-accent-name = Mittelalterlicher Akzent
trait-medieval-accent-desc = Hört, hört! Eure Art zu sprechen, wahrlich gar absonderlich!
trait-tile-movement-name = Innerer Frieden
trait-tile-movement-desc = Du bist immer in Kontakt mit deinen Wurzeln. Und mit deinen Wurzeln meine ich die Mitte der Kachel, auf der du stehst.

trait-movement-impaired-name = Gehbehinderung
trait-movement-impaired-desc = Du kommst ohne Hilfe nur schlecht voran. Gehstock inklusive.

movement-impaired-trait-examined = [color=yellow]{CAPITALIZE(SUBJECT($target))} scheint leicht zu hinken. Ohne Hilfe kommt {SUBJECT($target)} offenbar nicht gut voran.[/color]

trait-social-anxiety-name = Soziale Angststörung
trait-social-anxiety-disc = Du hast lähmende soziale Ängste und flippst bei Zuneigungsbekundungen wie Umarmungen aus.

trait-deaf-name = Taub
trait-deaf-disc =  Du bist völlig taub, du kannst nichts hören, auch nicht dich selbst!
