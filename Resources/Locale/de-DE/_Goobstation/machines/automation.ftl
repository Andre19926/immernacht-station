signal-port-name-powered = angetrieben
signal-port-description-powered = Dieser Port wird mit HIGH oder LOW aufgerufen, je nachdem, ob die Maschine ein- oder ausgeschaltet ist.

signal-port-name-plumbing-input = Sanitär: Input
signal-port-description-plumbing-input = Ein Sanitärautomatisierungsschlitz zum Pumpen von Flüssigkeiten.

signal-port-name-plumbing-output = Sanitäranlagen: Output
signal-port-description-plumbing-output = Ein Sanitärautomatisierungsschlitz, um Flüssigkeiten herauszupumpen.

signal-port-name-plumbing-dispenser = Sanitär: Spender
signal-port-description-plumbing-dispenser = Ein Sanitärautomatisierungsschlitz zum Pumpen von Flüssigkeiten in oder aus dem Becher eines Spenders.

# Robotic Arm

signal-port-name-input-machine = Artikel: Eingabemaschine
signal-port-description-input-machine = Ein Maschinenautomatisierungsschlitz, um Gegenstände herauszunehmen, anstatt sie vom Boden zu nehmen.

signal-port-name-output-machine = Artikel: Ausgabemaschine
signal-port-description-output-machine = Ein Maschinenautomatisierungsschlitz zum Einfügen von Gegenständen, anstatt sie auf den Boden zu legen.

signal-port-name-item-moved = Gegenstand bewegt
signal-port-description-item-moved = Signalanschluss, der gepulst wird, nachdem ein Gegenstand von diesem Arm bewegt wurde.

signal-port-name-automation-slot-filter = Gegenstand: Filterfach
signal-port-description-automation-slot-filter = Ein Automatisierungsschlitz für den Filter einer Automatisierungsmaschine.

# Reagent Grinder

signal-port-name-automation-slot-beaker = Gegenstand: Becherglas-Fach
signal-port-description-automation-slot-beaker = Ein Automatisierungsschlitz für den Becher einer Flüssigkeitsbehandlungsmaschine.

signal-port-name-automation-slot-input = Position: Eingabepositionen
signal-port-description-automation-slot-input = Ein Automatisierungssteckplatz für den Eingabeartikelspeicher einer Maschine.

# Flatpacker

signal-port-name-automation-slot-board = Gegenstand: Platinenfach
signal-port-description-automation-slot-board = Ein Automatisierungssteckplatz für die Leiterplatte eines Flatpackers.

signal-port-name-automation-slot-materials = Gegenstand: Materiallagerung
signal-port-description-automation-slot-materials = Ein Automatisierungsschlitz zum Einlegen von Materialien in das Lager einer Maschine.

# Disposal Unit

signal-port-name-flush = Spülen
signal-port-description-flush = Signalanschluss zum Umschalten des Spülmechanismus einer Entsorgungseinheit.

signal-port-name-eject = Auswerfen
signal-port-description-eject = Signalport zum Auswerfen des Inhalts einer Entsorgungseinheit.

signal-port-name-ready = Bereit
signal-port-description-ready = Signalanschluss, der gepulst wird, nachdem eine Entsorgungseinheit vollständig unter Druck gesetzt wurde.

# Storage Bin

signal-port-name-automation-slot-storage = Position: Lagerung
signal-port-description-automation-slot-storage = Ein Automatisierungsschlitz für das Inventar eines Lagerbehälters.

signal-port-name-storage-inserted = eingesetzt
signal-port-description-storage-inserted = Signalanschluss, der gepulst wird, nachdem ein Element in einen Speicherplatz eingefügt wurde.

signal-port-name-storage-removed = Entfernt
signal-port-description-storage-removed = Signalanschluss, der gepulst wird, nachdem ein Element aus einem Speicherplatz entfernt wurde.

# Fax Machine

signal-port-name-automation-slot-paper = Position: Papier
signal-port-description-automation-slot-paper = Ein Automatisierungsschlitz für das Papierfach eines Faxgeräts.

signal-port-name-fax-copy = Kopiere Fax
signal-port-description-fax-copy = Signalanschluss zum Kopieren des Papiers eines Faxgeräts.

# Constructor / Interactor

signal-port-name-machine-start = Start
signal-port-description-machine-start = Signalport, um eine Maschine einmal zu starten.

signal-port-name-machine-autostart = Autostart
signal-port-description-machine-autostart = Signalanschluss zur Steuerung des Startens nach dem automatischen Abschluss.

signal-port-name-machine-started = Beginn
signal-port-description-machine-started = Signalanschluss, der nach dem Start einer Maschine gepulst wird.

signal-port-name-machine-completed = Abgeschlossen
signal-port-description-machine-completed = Signalanschluss, der gepulst wird, nachdem eine Maschine ihre Arbeit abgeschlossen hat.

signal-port-name-machine-failed = Fehlgeschlagen
signal-port-description-machine-failed = Signalanschluss, der gepulst wird, nachdem eine Maschine nicht gestartet wurde.

# Interactor

signal-port-name-automation-slot-tool = Position: Werkzeug
signal-port-description-automation-slot-tool = Ein Automatisierungssteckplatz für das gehaltene Werkzeug eines Interaktors.

# Autodoc

signal-port-name-automation-slot-autodoc-hand = Gegenstand: Autodoc-Hand
signal-port-description-automation-slot-autodoc-hand = Ein Automatisierungs-Slot für das vom Autodoc gehaltene Organ bzw. Teil, für die Anweisungen „Gegenstand ablegen“ / „Gegenstand greifen“.

signal-port-name-alt-interact = Alt-Interaktionsmodus
signal-port-description-alt-interact = Signalport zum Umschalten des alternativen Interaktionsmodus oder setze ihn auf einen HIGH/LOW-Wert.

# Gas Canister

signal-port-name-automation-slot-gas-tank = Position: Gastank
signal-port-description-automation-slot-gas-tank = Ein Automatisierungsschlitz für einen Gastank.

# ChemMaster

signal-port-name-automation-slot-bottles = Gegenstand: Flaschenfach
signal-port-description-automation-slot-bottles = Ein Automatisierungssteckplatz für eine ChemMaster-Pille oder Flüssigkeitsflasche.

# Radiation Collector

signal-port-name-rad-empty = Leer
signal-port-description-rad-empty = Signalanschluss auf HIGH eingestellt, wenn der Tank fehlt oder unter 33% Druck, ansonsten LOW.

signal-port-name-rad-low = Niedrig
signal-port-description-rad-low = Signalanschluss auf HIGH eingestellt, wenn der Tank unter 66% Druck ist, ansonsten LOW.

signal-port-name-rad-full = voll
signal-port-description-rad-full = Signalanschluss auf HIGH eingestellt, wenn der Tank über 66% Druck ist, ansonsten LOW.

# Lathe
signal-port-name-lathe-print = Letztes Rezept ausdrucken
signal-port-description-lathe-print = Signalanschluss, der das zuletzt eingestellte Rezept druckt, wenn er gepulst wird.
