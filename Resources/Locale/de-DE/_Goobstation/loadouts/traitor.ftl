# Traitor Uplink Loadout Group
loadout-group-traitor-uplink = Uplink

# PDA Uplink Option
loadout-traitor-uplink-pda-name = PDA Uplink
loadout-traitor-uplink-pda-desc = Dein Uplink wird in deinem PDA versteckt. Gib den Code auf dem Klingelton deines PDA ein, um darauf zuzugreifen.

# Pen Uplink Option
loadout-traitor-uplink-pen-name = Pen Uplink
loadout-traitor-uplink-pen-desc = Dein Uplink wird in einem Stift versteckt. Spin zu deinem Code zum Entsperren. Auto-Locks wenn geschlossen.

# Implant Uplink Option
loadout-traitor-uplink-implant-name = Subdermales Implantat
loadout-traitor-uplink-implant-desc = Dein Uplink wird unter deiner Haut implantiert. Kosten 10 TC. Aktiviere es aus deinem Aktionsmenü.

