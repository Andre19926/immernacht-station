devil-roundend-name = Teufel
objective-issuer-devil = Teufel

roundend-prepend-devil-contracts = Jemand hat [color=red]{$number}[/color] erfolgreiche Verträge abgeschlossen.
roundend-prepend-devil-contracts-named = [color=white]{$name}[/color] hat [color=red]{$number}[/color] erfolgreiche Verträge abgeschlossen.

devil-component-examined = [color=darkred]{CAPITALIZE(POSS-ADJ($target))} Augen glimmen in einem schwachen Rot.[/color]
condemned-component-examined = [color=chartreuse]Die Augen von {CAPITALIZE($target)} sind hohl und seelenlos.[/color]

devil-role-greeting = Du bist ein Teufel aus den Tiefen der Hölle,
  der den Körper von {$playerName} bewohnt.
  Verderbe Sterbliche und sammle Seelen durch Verträge.
  Es liegt nicht in deinem Interesse, Aufgaben zu erledigen, die nichts mit deinen Geschäften zu tun haben, sie sind unter dir.
  Dein wahrer Name ist {$trueName} - versuch, ihn geheim zu halten, ja?

devil-true-name-heard = Dass {$speaker} den wahren Namen von {$target} ausspricht, zwingt {POSS-ADJ($target)} zum Innehalten.
devil-true-name-heard-chaplain = Die heiligen Worte von {$speaker} lassen den wahren Namen von {$target} bis in die Seele brennen.

objective-condition-contract-title = Seelen sammeln
objective-condition-contract-description = Sammle so viele Seelen wie möglich.

objective-condition-weight-title = Mache profitable Geschäfte.
objective-condition-weight-description = Sorge dafür, dass die Abmachungen dir so sehr wie möglich nutzen.

hand-shake-prompt-verb = Handschlag mit {$target}
hand-shake-accept-verb = Hand von {$target} schütteln

handshake-success = Du fühlst dich etwas leichter, als du {$user} die Hand schüttelst.
handshake-fail = Du schüttelst die Hand des Gegenübers, aber nichts passiert!

handshake-offer-popup = {$user} reicht dir {POSS-ADJ($user)} Hand, ein schlaues Grinsen auf {POSS-ADJ($user)} Gesicht.
handshake-offer-popup-self = Du streckst {$target} die Hand entgegen, ein verschmitztes Grinsen im Gesicht.

weaktoholy-component-bible-sizzle = Die Haut von {$target} wird von {$item} versengt!
devil-banish-begin = {$user} beginnt einen Exorzismus an {$target}!
devil-exorcised = Der Boden unter {$target} bricht auf und splittert, während sie in die Hölle zurückkehren.

invalid-possession-target = Du kannst dieses Ziel nicht besitzen!

devil-power-level-increase-weak = Flammenzungen flackern aus deinen Fingerspitzen. Deine Verbindung zur Hölle hat sich verstärkt.
devil-power-level-increase-moderate = Du spürst, wie deine Macht ansteigt. Deine Verbindung zur Hölle hat sich verstärkt.
devil-power-level-increase-powerful = Du hast deine Aufgaben hier fast erledigt. Nur noch ein paar Seelen.
