objective-condition-slaughter-devour-title = VERSCHLINGEN
objective-condition-slaughter-devour-desc = Verschlinge {$count} Crewmitglieder.

objective-condition-kill-wizard-first = [color=#FF0000]ZUERST,[/color]
objective-condition-kill-everyone-else = [color=#FF0000]DANACH,[/color]
objective-condition-kill-wizard-title = Töte den Zauberer, der dich beschworen hat
objective-condition-kill-everyone-else-title = TÖTE ALLE ANDEREN
objective-condition-kill-everyone-title = TÖTE ALLE

objective-condition-hug-and-tickle-title = UMARME SIE ALLE
objective-condition-hug-and-tickle-desc = Die Crew liebt es so sehr, dass sie überall Ketchup verteilt! Gut, dass du Ketchup liebst! Yupeee!

objective-kill-wizard-desc = Wer es gewagt hat, dich zu beschwören, muss den höchsten Preis zahlen.
    Sein arkanes Blut ruft nach dir. Finde ihn, jage ihn und schicke seine Seele schreiend in die Leere.
    Seine Magie endet hier.

objective-kill-everyone-desc =
    Dieses Reich riecht nach sterblichem Fleisch.
    Male diese Hallen purpurn, lass jeden Herzschlag zum Schweigen gebracht werden.
    Lass nichts als Echos des Terrors und Ströme von Blut.

# true fluff
objective-annihilate-janitors-title =
    Vernichte alle Hausmeister und ihren Roboterersatz.

objective-spare-crew-title =
    Verschone einige der Crew, um sie vor dem letzten Schlag bluten zu lassen.

objective-hunt-for-brave-title =
    Jage die Mutigen, die versuchen, zuerst dich zu jagen.

objective-hunt-the-cowards-title =
    Jage die Feiglinge, die vor dir fliehen.

# almost fluff
objective-spread-blood =
    Verteile Blut über {$area}.

objective-show-power-title =
    Zeige {$targetName} die wahre Macht des Blutes.

objective-drive-insane-title =
    Treibe {$targetName} mit deinem dämonischen Flüstern in den Wahnsinn.
