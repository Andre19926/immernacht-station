# For Sol Alliance Navy Deserters
ghost-role-information-deserter-name = Deserteur der Solarischen Marine
ghost-role-information-deserter-description = „Ich hab die Schnauze voll davon, dass der Quartiermeister mir meinen verdammten Gehaltsscheck nicht gibt! Schnappen wir uns eines der Landungsschiffe für eine Spritztour und plündern, um uns selbst zu bezahlen.“
ghost-role-information-deserter-rules =
    Du bist kein Terrorist, aber du bist auch nicht gerade ein großartiger Mensch. Tu, was immer nötig ist, um „zurückzubekommen, was die Marine uns schuldete“.
    Geiseln zu nehmen und unvernünftige Forderungen zu stellen, wird sehr ermutigt. Lebe deine Weltraumpiraten-Fantasie hier aus.
    Strenge dich nicht an, Massenvernichtung zu verursachen, denn wenn du die Station in Schlacke verwandelst, entgeht dir auch dein Zahltag.
roles-antag-sol-alliance-navy-deserter = Deserteur der Solarischen Marine
roles-antag-sol-alliance-navy-deserter-objective = Fülle dein Dropship mit so viel wertvoller Beute wie möglich, während du im nächsten Freeport damit prahlst.
id-card-access-level-sol-alliance-navy = SAN
role-type-SAN-antagonist-name = Deserteur

