cmd-setmind-desc = Überträgt ein Bewusstsein auf die angegebene Entity. Die Entität braucht eine {$requiredComponent}. Standardmäßig müssen Bewusstseine, die gerade andere Entitäten besuchen, zurückkehren (z. B. ein Geist in den Hauptkörper).
cmd-setmind-help = Verwendung: {$command} <entityUid> <Benutzername> [unvisit]
cmd-setmind-command-target-has-no-content-data-message = Der Zielspieler hat keine Content-Daten (wtf?)
cmd-setmind-command-target-has-no-mind-message = Die Ziel-Entität hat kein Bewusstsein (hast du vergessen, sie sentient zu machen?)
