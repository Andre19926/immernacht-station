cmd-setmind-help = Verwendung: {$command} <entityUid> <Benutzername> [unvisit]
cmd-setmind-command-target-has-no-content-data-message = Zielspieler hat keine Inhaltsdaten (wtf?)
cmd-setmind-command-target-has-no-mind-message = Ziel-Entität hat keinen Verstand (haben Sie vergessen, fühlend zu machen?)
