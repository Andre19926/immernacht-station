changecvar-simple-debug_test_cvar = Hat keine Wirkung.
changecvar-full-debug_test_cvar = Nur ein einfacher Test-Cvar. Tut nichts.

changecvar-simple-events_enabled = Kontrolliert, ob das Spiel Stationsereignisse ausführen soll.
changecvar-full-events_enabled = Kontrolliert, ob das Spiel Stationsereignisse ausführen soll.

changecvar-simple-shuttle_auto_call_time = Zeit nach der runde beginnen sie, das shuttle automatisch anzurufen.
changecvar-full-shuttle_auto_call_time = Zeit in Minuten nach der Runde, um das Shuttle automatisch anzurufen. Setze auf Null, um zu deaktivieren.

changecvar-simple-playtest_all_damage_modifier = Multiplikator für alle Schäden.
changecvar-full-playtest_all_damage_modifier = Multiplikator für alle Schäden.
changecvar-simple-playtest_all_heal_modifier = Multiplikator für alle Heilung getan.
changecvar-full-playtest_all_heal_modifier = Multiplikator für alle Heilung getan.
changecvar-simple-playtest_melee_damage_modifier = Multiplikator mit Auswirkungen auf Nahkampfwaffenschäden.
changecvar-full-playtest_melee_damage_modifier = Multiplikator, der alle Schäden durch Nahkampfangriffe beeinflusst.
changecvar-simple-playtest_projectile_damage_modifier = Multiplikator für Projektilschaden.
changecvar-full-playtest_projectile_damage_modifier = Multiplikator, der alle von Projektilen verursachten Schäden beeinflusst.
changecvar-simple-playtest_hitscan_damage_modifier = Multiplikator für Hitscan-Schaden.
changecvar-full-playtest_hitscan_damage_modifier = Multiplikator, der alle Schäden betrifft, die von Hitscan-Waffen verursacht werden.
changecvar-simple-playtest_thrown_damage_modifier = Multiplikator, der den Schaden von geworfenen Waffen beeinflusst.
changecvar-full-playtest_thrown_damage_modifier = Multiplikator, der sich auf alle Schäden auswirkt, die durch geworfene Waffen verursacht werden.
changecvar-simple-playtest_topicals_heal_modifier = Multiplikator für lokale Heilung.
changecvar-full-playtest_topicals_heal_modifier = Multiplikator, der alle Heilungen durch Topicals beeinflusst.
changecvar-simple-playtest_reagent_damage_modifier = Multiplikator für Reagenzienschaden.
changecvar-full-playtest_reagent_damage_modifier = Multiplikator, der alle Schäden durch Reagenzien beeinflusst.
changecvar-simple-playtest_reagent_heal_modifier = Multiplikator für Reagenzienheilung.
changecvar-full-playtest_reagent_heal_modifier = Multiplikator, der alle Heilungen durch Reagenzien beeinflusst.
changecvar-simple-playtest_explosion_damage_modifier = Multiplikator für Explosionsschaden.
changecvar-full-playtest_explosion_damage_modifier = Multiplikator, der alle durch Sprengstoffe verursachten Schäden beeinflusst.
changecvar-simple-playtest_stamina_damage_modifier = Multiplikator für Ausdauerschaden.
changecvar-full-playtest_stamina_damage_modifier = Multiplikator, der alle behandelten Ausdauerschäden beeinflusst.
changecvar-simple-playtest_mob_damage_modifier = Multiplikator, der alle Schäden an Mobs betrifft.
changecvar-full-playtest_mob_damage_modifier = Multiplikator auf allen Schaden, der Entitäten mit MobStateComponent zugefügt wird.
