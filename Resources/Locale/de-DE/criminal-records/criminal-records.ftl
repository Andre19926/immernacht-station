criminal-records-console-not-suspected = {$name} ({$job}wurde vom Verdacht freigesprochen durch {$officer}.
criminal-records-console-detained = {$name} ({$job}Inhaftiert wurde von {$officer}.
criminal-records-console-released = {$name} ({$job}) freigegeben wurde durch {$officer}.
criminal-records-console-paroled = {$name} ({$job}wurde auf Bewährung freigegeben von {$officer}.
criminal-records-console-not-parole = {$officer} Der Parole Status von {$name} ({$job}).
criminal-records-console-hostile = {$name} ({$job}wurde als feindselig gekennzeichnet durch {$officer} für: {$reason}.
criminal-records-console-not-hostile = {$name} ({$job}nicht mehr als feindselig gekennzeichnet durch {$officer}.
criminal-records-console-eliminated = {$name} ({$job}wurde als eliminiert markiert durch {$officer}.
criminal-records-console-not-eliminated = {$name} ({$job}) nicht mehr als eliminiert gekennzeichnet durch {$officer}.
criminal-records-console-search = {$officer} gekennzeichnet {$name} ({$job}) für die Suche wegen: {$reason}
criminal-records-console-not-search = {$officer} den Suchstatus von {$name} ({$job}).
criminal-records-console-perma = {$name} ({$job}wurde zu perma verurteilt durch {$officer}.
criminal-records-console-not-perma = {$name} ({$job}wurde von perma befreit {$officer}.
criminal-records-console-dangerous = {$officer} gekennzeichnet {$name} ({$job}) als gefährlich wegen: {$reason}.
criminal-records-console-not-dangerous = {$name} ({$job}ist keine Bedrohung mehr durch {$officer}.

