ash-storm-telegraph = [color=red][bold]Ein unheimliches Stöhnen erhebt sich über dem Wind. Blätter brennender Asche schwärzen den Horizont. Suche Schutz.[/bold][/color]
ash-storm-alert = [color=red][bolditalic]Schwelende Wolken sengender Asche wirbeln um dich herum! Geh rein![/bolditalic][/color]
ash-storm-clearing = [color=red]Der heulende Wind fegt die letzte Asche davon und legt sich zu seinem gewohnten Murmeln. Es sollte jetzt sicher sein, nach draußen zu gehen.[/color]
