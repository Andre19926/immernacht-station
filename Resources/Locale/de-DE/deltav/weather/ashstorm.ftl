ash-storm-telegraph = [color=red][bold]Ein unheimliches Stöhnen erhebt sich über dem Wind. Blätter brennender Asche schwärzen den Horizont. Suche Schutz.[/bold][/color]
ash-storm-alert = [color=red][bolditalic]Schwelende Wolken von sengender Asche schwirren um dich herum! Geh rein![/bolditalic][/color]
ash-storm-clearing = [color=red]Der kreischende Wind peitscht die letzte Asche weg und fällt zu seinem üblichen Geräusch. Es sollte jetzt sicher sein, nach draußen zu gehen.[/color]
