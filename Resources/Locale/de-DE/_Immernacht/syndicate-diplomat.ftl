# Entitäten
ent-ClothingUniformJumpsuitSyndicateDiplomat = Syndikat-Diplomatenanzug
    .desc = Ein maßgeschneiderter rot-schwarzer Anzug für offizielle Gesandte des Syndikats. Makellos neutral, meistens.
ent-ClothingUniformJumpskirtSyndicateDiplomat = Syndikat-Diplomatenrock
    .desc = Ein maßgeschneidertes rot-schwarzes Kostüm mit Rock für offizielle Gesandte des Syndikats. Makellos neutral, meistens.
ent-EncryptionKeySyndicateDiplomat = Diplomatischer Verschlüsselungsschlüssel
    .desc = Ein Verschlüsselungsschlüssel für die Stationskanäle und den Syndikat-Kanal, ausgegeben an offizielle Gesandte.
ent-ClothingHeadsetSyndicateDiplomat = Diplomaten-Over-Ear-Headset
    .desc = Ein blutrotes Over-Ear-Headset für offizielle Syndikat-Gesandte. Abgestimmt auf die Stationskanäle und den Syndikat-Kanal.
ent-RubberStampSyndicateDiplomat = Diplomat-Stempel
    .desc = Das offizielle Siegel eines Syndikat-Gesandten. Lässt jeden Vertrag sehr verbindlich wirken.
ent-PaperSyndicateDiplomatTradeAgreement = Handelsabkommen (Vorlage)
    .desc = Eine leere Vorlage für ein Handelsabkommen mit Syndikat-Briefkopf.
ent-PaperSyndicateDiplomatNonAggression = Nichtangriffspakt (Vorlage)
    .desc = Eine leere Vorlage für einen Nichtangriffspakt. Gültig, solange beide Seiten Lust darauf haben.
ent-PaperSyndicateDiplomatFavor = Gefälligkeitsvertrag (Vorlage)
    .desc = Eine leere Vorlage für einen Gefälligkeitsvertrag. Gefallen sind handelbar. Es fallen Zinsen an.
ent-BriefcaseSyndicateDiplomat = Diplomatenkoffer
    .desc = Ein robuster Aktenkoffer mit dezentem roten Syndikat-Wappen. Nur für offizielle Gesandte.
    .suffix = Leer
ent-BriefcaseSyndicateDiplomatFilled = Diplomatenkoffer
    .desc = Ein robuster Aktenkoffer mit dezentem roten Syndikat-Wappen. Nur für offizielle Gesandte.
    .suffix = Gefüllt
ent-SyndicateDiplomatIDCard = Syndikat-Diplomaten-Ausweis
    .desc = Eine Karte, die für den Zugang zu verschiedenen Bereichen an Bord der Station erforderlich ist.
ent-SyndicateDiplomatPDA = Syndikat-Diplomaten-PDA
    .desc = Ein offizielles PDA des diplomatischen Korps des Syndikats. Riecht leicht nach Zigarettenrauch und Lobbyarbeit.
ent-SyndicateDiplomatUplink = Diplomatenkurier
    .desc = Ein diskretes Kurierterminal des diplomatischen Korps des Syndikats. Tauscht Gefallen gegen Lebensart, Geschenke und Bürobedarf.
ent-SpawnPointSyndicateDiplomat = Syndikat-Diplomat

