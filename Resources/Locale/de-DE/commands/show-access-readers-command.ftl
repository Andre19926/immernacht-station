cmd-showaccessreaders-desc = Schaltet die Anzeige der Berechtigungen von Zugangslesern auf der Karte um
cmd-showaccessreaders-help =
    Overlay-Info:
        -Disabled | Der Zugangsleser ist deaktiviert
        +Unrestricted | Der Zugangsleser hat keine Einschränkungen
        +Set [Index]: [Tag Name] | Ein Tag in einem Zugangsset (der Zugreifende braucht alle Tags des Sets)
        +Key [StationUid]: [StationRecordKeyId] | Ein erlaubter StationRecordKey
        -Tag [Tag Name] | Ein nicht erlaubter Tag (hat Vorrang vor anderen Erlaubnissen)
cmd-showaccessreaders-status = Debug-Overlay für Zugangsleser auf {$status} gesetzt.
