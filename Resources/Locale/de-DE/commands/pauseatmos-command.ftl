cmd-pauseatmos-desc = Pausiert oder setzt die Atmosphären-Simulation für die angegebene Struktur (Grid) fort.
cmd-pauseatmos-help = Verwendung: {$command} <EntityUid>
cmd-pauseatmos-set-atmos-simulation = Atmosphären-Simulation auf {$grid} auf Zustand {$state} gesetzt.
cmd-pauseatmos-completion-grid-pause = EntityUid der Struktur, die du pausieren/fortsetzen willst. Ohne Angabe wird automatisch die Struktur verwendet, auf der du stehst.
