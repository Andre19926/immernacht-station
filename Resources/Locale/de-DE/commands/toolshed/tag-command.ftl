command-description-tag-list =
    Listet die Tags der angegebenen Entitäten auf.
command-description-tag-with =
    Gibt aus der weitergeleiteten Entitätenliste nur die Entitäten mit dem angegebenen Tag zurück.
command-description-tag-add =
    Fügt den angegebenen Entitäten einen Tag hinzu.
command-description-tag-rm =
    Entfernt einen Tag von den angegebenen Entitäten.
command-description-tag-addmany =
    Fügt den angegebenen Entitäten eine Liste von Tags hinzu.
command-description-tag-rmmany =
    Entfernt eine Liste von Tags von den angegebenen Entitäten.
