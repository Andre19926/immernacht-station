command-description-stations-list =
    Gibt eine Liste aller Stationen zurück.
command-description-stations-get =
    Gibt die aktive Station zurück, falls es genau eine gibt.
command-description-stations-getowningstation =
    Gibt die Station zurück, zu der eine bestimmte Entität gehört (in der sie sich befindet).
command-description-stations-grids =
    Gibt alle Strukturen (Grids) der Eingabe-Station zurück.
command-description-stations-config =
    Gibt die Konfiguration der Eingabe-Station zurück, falls vorhanden.
command-description-stations-addgrid =
    Fügt der angegebenen Station eine Struktur (Grid) hinzu.
command-description-stations-rmgrid =
    Entfernt eine Struktur (Grid) von der angegebenen Station.
command-description-stations-rename =
    Benennt die angegebene Station um.
command-description-stations-largestgrid =
    Gibt die größte Struktur (Grid) der angegebenen Station zurück, falls vorhanden.
command-description-stations-rerollBounties =
    Löscht alle aktuellen Kopfgelder der Station und wählt neue aus.
