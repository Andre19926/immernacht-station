command-description-xenoartifact-list =
    Listet alle EntityUids gespawnter Artefakte auf.
command-description-xenoartifact-printMatrix =
    Gibt eine Matrix aus, die alle Kanten zwischen Nodes darstellt.
command-description-xenoartifact-totalResearch =
    Gibt alle Forschungspunkte aus, die derzeit aus dem Artefakt gewonnen werden können.
command-description-xenoartifact-averageResearch =
    Berechnet, wie viele Forschungspunkte ein durchschnittlich erzeugtes Xeno-Artefakt bei voller Aktivierung abgibt.
command-description-xenoartifact-unlockAllNodes =
    Schaltet alle Nodes des Artefakts frei.
