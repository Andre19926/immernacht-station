command-description-statuseffect-add =
    Addiert Sekunden zur Dauer eines Statuseffekts oder erstellt einen mit entsprechender Dauer.
command-description-statuseffect-update =
    Setzt die Dauer eines Statuseffekts auf den höheren Wert aus eingegebener und bestehender Zeit. Bei 0 ist die Dauer unbegrenzt.
command-description-statuseffect-set =
    Setzt die Dauer eines Statuseffekts auf die eingegebene Zeit in Sekunden. Bei 0 ist die Dauer unbegrenzt.
command-description-statuseffect-remove =
    Entfernt per Prototyp Zeit von einem Statuseffekt. Ist keine Zeit angegeben, wird der Statuseffekt entfernt.
