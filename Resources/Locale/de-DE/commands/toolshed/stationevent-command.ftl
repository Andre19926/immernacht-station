command-description-stationevent-simulate =
    Simuliert anhand eines BasicStationEventScheduler-Prototyps, N Runden, N Spielern, mittlerem Rundenende und dessen Standardabweichung N Runden, in denen Events auftreten, und gibt danach das Auftreten jedes Events aus.
command-description-stationevent-lsprob =
    Listet anhand eines BasicStationEventScheduler-Prototyps die Wahrscheinlichkeit auf, mit der verschiedene Stationsevents unter den aktuellen Bedingungen aus dem gesamten Pool auftreten.
command-description-stationevent-lsprobtheoretical =
    Listet anhand eines BasicStationEventScheduler-Prototyps, einer Spielerzahl und einer Rundenzeit die Wahrscheinlichkeit auf, mit der verschiedene Stationsevents für die angegebene Spielerzahl und Rundenzeit auftreten.
command-description-stationevent-prob =
    Gibt anhand eines BasicStationEventScheduler-Prototyps und eines Event-Prototyps die Wahrscheinlichkeit zurück, mit der ein einzelnes Stationsevent unter den aktuellen Bedingungen aus dem gesamten Pool auftritt.
